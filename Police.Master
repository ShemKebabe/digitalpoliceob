<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Police.master.cs" Inherits="Occurence_Book_Management_System.Police" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>Kenya Police Service</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet' />
    <link href="Styles/Master.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="bg-light">
    <form id="form1" runat="server">
        <div class="container-fluid master-page">
            <div class="row g-0">
                <div class="col-sm-2 navigation-bar d-flex flex-column justify-content-between">
                    <nav class="navbar d-flex flex-column align-items-start">

                        <div>
                            <p class="app-name ps-3 pt-3">Kenya Police Service</p>
                        </div>

                          <div class="container-fluid">
                            <ul class="navbar-nav">
                              <li class="nav-item ps-2">
                                <a class="nav-link text-white navigation d-flex align-items-center" href="Dashboard.aspx">
                                    <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24"  
                                    fill="#fff" viewBox="0 0 24 24" class="pe-2" >
                                    <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
                                    <path d="M17 3c-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4m0 6c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2M7 21c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4m0-6c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2m-2.5-4h5c.83 0 1.5-.67 1.5-1.5v-5c0-.83-.67-1.5-1.5-1.5h-5C3.67 3 3 3.67 3 4.5v5c0 .83.67 1.5 1.5 1.5M5 5h4v4H5zm14.5 8h-5c-.83 0-1.5.67-1.5 1.5v5c0 .83.67 1.5 1.5 1.5h5c.83 0 1.5-.67 1.5-1.5v-5c0-.83-.67-1.5-1.5-1.5m-.5 6h-4v-4h4z"></path>
                                    </svg>
                                    Dashboard
                                </a>
                              </li>
                              <li class="nav-item ps-2">
                                <a class="nav-link text-white navigation d-flex align-items-center" href="NewEntry.aspx">
                                    <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24"  
                                        fill="#fff" viewBox="0 0 24 24" class="pe-2" >
                                        <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
                                        <path d="M13 10h-2v3H8v2h3v3h2v-3h3v-2h-3z"></path><path d="m19.94 7.68-.03-.09a.8.8 0 0 0-.2-.29l-5-5c-.09-.09-.19-.15-.29-.2l-.09-.03a.8.8 0 0 0-.26-.05c-.02 0-.04-.01-.06-.01H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2v-12s-.01-.04-.01-.06c0-.09-.02-.17-.05-.26ZM6 20V4h7v4c0 .55.45 1 1 1h4v11z"></path>
                                    </svg>
                                    New OB Entry
                                </a>
                              </li>
                              <li class="nav-item ps-2">
                                <a class="nav-link text-white navigation d-flex align-items-center" href="#">
                                    <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24"  
                                        fill="#fff" viewBox="0 0 24 24" class="pe-2" >
                                        <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
                                        <path d="M21 3h-7c-.77 0-1.47.3-2 .78-.53-.48-1.23-.78-2-.78H3c-.55 0-1 .45-1 1v15c0 .55.45 1 1 1h5.76c.53 0 1.04.21 1.41.59l1.12 1.12s.02.01.03.02c.09.08.18.15.29.2.12.05.25.08.38.08s.26-.03.38-.08c.11-.05.21-.12.29-.2 0 0 .02-.01.03-.02l1.12-1.12c.37-.37.89-.59 1.41-.59h5.76c.55 0 1-.45 1-1V4c0-.55-.45-1-1-1ZM8.76 18H4V5h6c.55 0 1 .45 1 1v12.69c-.66-.44-1.44-.69-2.24-.69M20 18h-4.76c-.8 0-1.58.25-2.24.69V6c0-.55.45-1 1-1h6z"></path>
                                    </svg>
                                    OB Entries
                                </a>
                              </li>
                                <li class="nav-item mt-4 ps-2">
                                  <a class="nav-link public d-flex align-items-center" href="#">
                                      <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24"  
                                        fill="#fff" viewBox="0 0 24 24" class="pe-2" >
                                        <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
                                        <path d="M12 2C6.49 2 2 6.49 2 12s4.49 10 10 10 10-4.49 10-10S17.51 2 12 2m7.93 9h-2.95c-.11-2.44-.62-4.58-1.42-6.15A8.01 8.01 0 0 1 19.93 11M12 20c-1.14 0-2.75-2.7-2.97-7h5.94c-.22 4.3-1.84 7-2.97 7m-2.97-9c.22-4.3 1.84-7 2.97-7s2.75 2.7 2.97 7zm-.59-6.15C7.65 6.43 7.13 8.56 7.02 11H4.07a8.01 8.01 0 0 1 4.37-6.15M4.07 13h2.95c.11 2.44.62 4.58 1.42 6.15A8.01 8.01 0 0 1 4.07 13m11.49 6.15c.79-1.58 1.31-3.71 1.42-6.15h2.95a8.01 8.01 0 0 1-4.37 6.15"></path>
                                       </svg>
                                      Public Portal
                                  </a>
                                </li>
                            </ul>
                          </div>
                    </nav>
                    <nav class="navbar">
                        <div class="container-fluid">
                            <ul class="navbar-nav">
                                <li class="nav-item ps-2">
                                  <a class="nav-link public d-flex align-items-center" href="#">
                                      <svg  xmlns="http://www.w3.org/2000/svg" width="24" height="24"  
                                        fill="#fff" viewBox="0 0 24 24" class="pe-2" >
                                        <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
                                        <path d="M15 11H8v2h7v4l6-5-6-5z"></path><path d="M5 21h7v-2H5V5h7V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2"></path>
                                      </svg>
                                      Sign Out
                                  </a>
                                </li>
                            </ul>
                        </div>
                    </nav> 
                </div> 
                <div class="col">
                    <div class="content-section d-flex justify-content-between align-items-center p-4">
                        <div class="close-navbar p-1">
                            <svg  xmlns="http://www.w3.org/2000/svg" width="20" height="20"  
                                fill="#000" viewBox="0 0 24 24" >
                                <!--Boxicons v3.0.8 https://boxicons.com | License  https://docs.boxicons.com/free-->
                                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2M5 19V5h3v14zm5 0V5h9v14z"></path>
                            </svg>
                        </div>

                        <div class="pt-3">
                            <p class="current-date">
                                <%= DateTime.Now.ToString("dddd, dd MMMM yyyy") %>
                            </p>
                        </div>
                    </div>

                    <div>
                        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                        </asp:ContentPlaceHolder>
                    </div>
                </div>
            </div>
        </div>
    </form>
</body>
</html>
